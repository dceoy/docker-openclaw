# Docker image reference used by Compose and buildx bake.
OPENCLAW_IMAGE=openclaw:local

# Dockerfile build args.
# OpenClaw is pinned in package.json and pnpm-lock.yaml.
OPENCLAW_NODE_VERSION=22
OPENCLAW_USER_NAME=claw
OPENCLAW_USER_UID=1001
OPENCLAW_USER_GID=1001
# Space-separated apt packages to install in the runtime image.
OPENCLAW_DOCKER_APT_PACKAGES=
# Set to 1 to preinstall Chromium + Xvfb for browser automation.
OPENCLAW_INSTALL_BROWSER=
# Set to 1 to add Docker CLI support for container-backed sandboxing.
OPENCLAW_INSTALL_DOCKER_CLI=

# Runtime paths.
OPENCLAW_CONFIG_DIR=./.openclaw
OPENCLAW_WORKSPACE_DIR=./workspace

# Gateway networking.
# Use bind modes such as lan or loopback, not raw hostnames like 0.0.0.0.
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Gateway auth and connectivity.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# Optional browser runtime tuning.
OPENCLAW_BROWSER_DISABLE_GRAPHICS_FLAGS=
OPENCLAW_BROWSER_DISABLE_EXTENSIONS=
OPENCLAW_BROWSER_RENDERER_PROCESS_LIMIT=

# Claude credentials.
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# Model and voice provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
